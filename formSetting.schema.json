{
  "title": "FormSetting",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier of the singleton setting for the organization"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid"
    },
    "rows": {
      "type": "array",
      "description": "Custom fields appended after the built-in task fields; at most 2 fields per row",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "date",
                    "datetime",
                    "email"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "required": {
                  "type": "boolean"
                },
                "disabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "type",
                "label",
                "required",
                "disabled"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "organizationId",
    "rows",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
