{
  "name": "kitameraki-be-test",
  "version": "1.0.0",
  "description": "Task management API built with Azure Functions and Azure Cosmos DB",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "seed": "npm run build && node dist/scripts/seed.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "nodemon --watch dist --ext js --exec \"func start\""
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "main": "dist/src/functions/*.js"
}
